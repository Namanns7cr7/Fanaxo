# Fanaxo web — environment template. Copy to .env.local for local dev, or set
# these as environment variables on your deployment host. NEVER commit real secrets.

# --- AI copilot (fan assistant + operator recommendations) ---
# 'google' = Gemini 2.5, 'anthropic' = Claude, 'mock' = deterministic (no key).
AI_PROVIDER=google
# Free key at https://aistudio.google.com/apikey (starts with AIza...).
GEMINI_API_KEY=
# Only needed if AI_PROVIDER=anthropic.
ANTHROPIC_API_KEY=

# --- Runtime ---
# Long random string used to hash session tokens at rest. Generate one for prod:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Absolute path on a PERSISTENT volume in production (e.g. /data/fanaxo.db).
DATABASE_FILE=/data/fanaxo.db
# Seeds demo data + demo logins on first boot when the DB is empty.
DEMO_MODE=true
