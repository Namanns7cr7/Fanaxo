# ============================================================
# FANAXO AI — Environment Variables
# ============================================================
# Copy this file to .env.local and fill in your values.
# NEVER commit real secrets to source control.
# ============================================================

# --- Database ---
# PostgreSQL connection string for production
# For local dev with SQLite, use: file:./dev.db
DATABASE_URL="file:./dev.db"

# --- Authentication ---
# Secret for signing session cookies (generate with: openssl rand -hex 32)
SESSION_SECRET="replace-with-random-64-char-hex-string"

# --- AI Provider ---
# Supported: "gemini" | "openai" | "mock"
AI_PROVIDER="mock"

# Google Gemini API key (if AI_PROVIDER=gemini)
GEMINI_API_KEY=""

# OpenAI API key (if AI_PROVIDER=openai)
OPENAI_API_KEY=""

# --- Application ---
# Base URL of the application
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Environment: "development" | "preview" | "production"
NODE_ENV="development"

# Enable demo mode with seeded data and demo accounts
DEMO_MODE="true"

# --- Security ---
# Allowed origins for CORS (comma-separated)
ALLOWED_ORIGINS="http://localhost:3000"

# Rate limiting window in milliseconds
RATE_LIMIT_WINDOW_MS="60000"

# Maximum requests per rate limit window
RATE_LIMIT_MAX_REQUESTS="100"
